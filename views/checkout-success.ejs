<%- include('partials/header') %>

<div
  style="
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 75vh;
    background-color: #1a202c;
    padding: 20px;
  "
>
  <div
    style="
      background: #2d3748;
      padding: 45px 40px;
      border-radius: 16px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
      max-width: 480px;
      width: 100%;
      border: 1px solid #4a5568;
      text-align: center;
    "
  >
    <div
      style="
        margin: 0 auto 24px auto;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 80px;
        height: 80px;
        background: rgba(56, 161, 105, 0.1);
        border-radius: 50%;
        border: 2px solid #38a169;
        box-shadow: 0 0 15px rgba(56, 161, 105, 0.4);
      "
    >
      <span
        style="
          font-size: 2.5rem;
          color: #48bb78;
          text-shadow: 0 0 10px rgba(72, 187, 120, 0.5);
        "
        >✓</span
      >
    </div>

    <h2
      style="
        margin: 0 0 8px 0;
        color: #f7fafc;
        font-size: 1.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
      "
    >
      Game Unlocked!
    </h2>

    <p
      style="
        color: #a0aec0;
        margin: 0 0 32px 0;
        font-size: 0.95rem;
        line-height: 1.5;
      "
    >
      Payment confirmed. Your digital activation keys and receipt have been
      dispatched directly to your email.
    </p>

    <hr
      style="border: 0; border-top: 1px dashed #4a5568; margin-bottom: 32px"
    />

    <div
      style="
        background: #1a202c;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #4a5568;
        margin-bottom: 32px;
      "
    >
      <p
        style="
          margin: 0;
          font-size: 1rem;
          color: #e2e8f0;
          font-weight: 600;
          line-height: 1.4;
        "
      >
        Gear up and get ready to play. What's your next move?
      </p>
    </div>

    <div style="display: flex; gap: 16px; justify-content: center">
      <a
        href="/"
        style="
          flex: 1;
          background: linear-gradient(135deg, #0022ff 0%, #0195c2 100%);
          color: #ffffff;
          text-decoration: none;
          padding: 14px 20px;
          border-radius: 8px;
          font-weight: 600;
          font-size: 0.95rem;
          box-shadow: 0 4px 14px rgba(211, 113, 0, 0.3);
          transition: opacity 0.15s ease;
          text-align: center;
        "
        onmouseover="this.style.opacity = '0.9'"
        onmouseout="this.style.opacity = '1'"
      >
        Continue Browsing
      </a>

      <a
        href="/logout"
        style="
          flex: 1;
          background: transparent;
          color: #e2e8f0;
          text-decoration: none;
          padding: 14px 20px;
          border-radius: 8px;
          font-weight: 600;
          font-size: 0.95rem;
          border: 1px solid #718096;
          transition: background 0.15s ease;
          text-align: center;
        "
        onmouseover="this.style.background = '#1a202c'"
        onmouseout="this.style.background = 'transparent'"
      >
        Log Out
      </a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
