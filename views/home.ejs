<%- include('partials/header') %>

<style>
    /* Hero Banner Base Setup - Dark Gamer Theme */
    .hero-banner {
        display: flex;
        background:#2d374800;
        color: white;
        padding: 0px ;
        text-align: center;
        border-radius: 12px;
        margin-bottom: 40px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    }
    .hero-banner h1 { margin: 0 0 10px 0; font-size: 2.5rem; }
    .hero-banner p { margin: 0; font-size: 1.2rem; color: #e2e8f0; }

    /* Integrated Slideshow Styles */
    .slideshow-container {
        display: none;
        position: relative;
        width: 120%;
        max-height: 340px;
        margin: 0 auto;
        overflow: hidden;
        border-radius: 11px; /* Slightly smaller than banner to fit inside border */
    }
    .mySlides {
        display: none;
        width: 100%;
        height: 350px;
        object-fit: cover;
        animation: fadeEffect 1.5s;
    }
    @keyframes fadeEffect {
        from {
            opacity: 0.4;
            transform: scale(1.03);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }
    #loader {
        text-align: center;
        padding: 60px 0;
        font-family: Arial, sans-serif;
        color: #edf2f7; 
    }

    /* Core Page Layout Classes */
    .section-title {
        color: #ffffff;
        border-bottom: 2px solid #b2d8f9;
        padding-bottom: 10px;
        margin-bottom: 20px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Offers Dashboard Flex Layout */
    .offers-grid {
        margin-bottom: 5px;
        flex-wrap: wrap;
        padding: 0px 0px 0px 20px;
    }
    .offer-card {
        background: #00aaff0f;
        border: 1px solid #feebc8;
        margin-bottom: 5px;
        border-radius: 8px;
        padding: 20px;
        flex: 1;
        position: relative;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        transition: transform 0.2s;
    }
    .offer-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 6px rgb(109, 206, 255);
    }
    .offer-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        background: #ff5500; /* Action red */
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: bold;
        text-transform: uppercase;
    }
    .offer-card h3 { margin: 0 0 10px 0; color: #bbebff; font-size: 1.25rem; padding-right: 80px; }
    .offer-card p { margin: 0; color: #ffffff; font-size: 0.95rem; line-height: 1.5; }

    /* Catalog Grid Layout */
    .home-catalog-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 25px;
        margin-bottom: 40px;
    }
    .home-card {
        background: #00aaff0f;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        box-shadow: 0 2px 5px rgba(0,0,0,0.04);
        display: flex;
        flex-direction: column;
        transition: box-shadow 0.2s, transform 0.2s;
    }
    .home-card:hover {
        box-shadow: 0 8px 15px rgb(67, 205, 255);
        transform: translateY(-3px);
    }
    .home-card img { width: 100%; height: 200px; object-fit: cover; background: #edf2f7; }
    .home-card-body { padding: 20px; display: flex; flex-direction: column; flex-grow: 1; text-align: center; }
    .home-card-body strong { font-size: 1.2rem; color: #ffffff; display: block; margin-bottom: 8px; }

    .btn-add {
        background: #00e1ff;
        color: black;
        border: none;
        padding: 12px 15px;
        border-radius: 6px;
        font-size: 18px;
        font-weight: bold;
        width: 100%;
        cursor: pointer;
        transition: opacity 0.2s;
        box-shadow: 0 4px 10px rgba(211, 113, 0, 0.2);
    }
    .btn-add:hover {
        opacity: 0.9;
        background: #2e84fc;
        color: white;
    }

    /* Responsive Fallbacks */
    @media (max-width: 1024px) {
        .home-catalog-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 768px) {
        .home-catalog-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 480px) {
        .home-catalog-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="full-page-container" style="max-width: 1200px; margin: 0 auto; padding: 20px;">

    <header class="hero-banner">
        <div id="loader">
            <h2>Loading Gear...</h2>
            <p>Please wait while we fetch the high-def assets. Setting sail to the storefront...</p>
        </div>

        <div class="slideshow-container" id="slideshow">
            <img class="mySlides" src="/testimg/1.jpg" />
            <img class="mySlides" src="/testimg/2.jpg" />
            <img class="mySlides" src="/testimg/3.jpg" />
            <img class="mySlides" src="/testimg/4.jpg" />
            <img class="mySlides" src="/testimg/5.jpg" />
            <img class="mySlides" src="/testimg/6.jpg" />
            <img class="mySlides" src="/testimg/7.jpg" />
            <img class="mySlides" src="/testimg/8.jpg" />
            <img class="mySlides" src="/testimg/9.jpg" />
            <img class="mySlides" src="/testimg/10.jpg" />
        </div>
        <section>
            <h2 class="section-title">🔥 Gamer Buddy Deals</h2>
            <div class="offers-grid">
                <% offers.forEach(offer => { %>
                <div class="offer-card">
                    <span class="offer-badge"><%= offer.badge %></span>
                    <h3><%= offer.title %></h3>
                    <p><%= offer.description %></p>
                </div>
                <% }) %>
            </div>
        </section>
    </header>

    <section>
        <h2 class="section-title">🎮 Latest Gear & Games</h2>
        <div class="home-catalog-grid">
            <% products.forEach(product => { %>
                <div class="home-card">
                    <img src="<%= product.imagePath %>" alt="<%= product.name %>">
                    <div class="home-card-body">
                        <strong><%= product.name %></strong>
                        <div class="price" style="font-size: 1.2rem; margin-bottom: 15px; color: #ffffff; font-weight: bold;">
                            BDT. <%= product.price.toFixed(2) %>
                        </div>
                        <% if (typeof user !== 'undefined' && user && (user.role === 'admin' || user.username.toLowerCase() === 'admin')) { %>
                            <div style="margin-top: auto; padding: 12px; text-align: center; color: #a0aec0; background: #2d3748; border-radius: 6px; font-size: 0.85rem;">
                                View Only Mode
                            </div>
                        <% } else { %>
                        <form action="/cart/add" method="POST" style="margin-top: auto;">
                            <input type="hidden" name="productId" value="<%= product.id %>">
                            <button type="submit" class="btn-add">Add to Cart 🛒</button>
                        </form>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
    </section>
</div>

<script>
    var slideIndex = 0;    
    function initSlideshow() {
        document.getElementById("loader").style.display = "none";
        document.getElementById("slideshow").style.display = "block";
        showSlides();
    }

    function showSlides() {
        var i;
        var slides = document.getElementsByClassName("mySlides");
        for (i = 0; i < slides.length; i++) {
            slides[i].style.display = "none";
        }
        slideIndex++;
        if (slideIndex > slides.length) {
            slideIndex = 1;
        }
        if (slides[slideIndex - 1]) {
            slides[slideIndex - 1].style.display = "block";
        }
        setTimeout(showSlides, 3000);
    }

    window.addEventListener('DOMContentLoaded', initSlideshow);
</script>

<%- include('partials/footer') %>